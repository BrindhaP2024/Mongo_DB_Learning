db.company_details.find();

db.emp_details.aggregate([
  {
    $lookup: {
      from: "company_details",       
      localField: "company",          
      foreignField: "company",        
      as: "company_info"             
    }
  },
  {
    $unwind: {
      path: "$company_info",         
      preserveNullAndEmptyArrays: true
    }
  },
  {
    $project: {
      name: 1,
      company: 1,
      designation: 1,
      location: "$company_info.location",
      founded: "$company_info.founded",
      _id: 0
    }
  }
]);

