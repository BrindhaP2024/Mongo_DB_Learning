use shopDB;

db.orders.insertMany([
  {
    _id: 1,
    customer: "Arjun",
    items: [
      { product: "Book", quantity: 2, price: 10 },
      { product: "Pen", quantity: 3, price: 2 }
    ],
    status: "delivered"
  },
  {
    _id: 2,
    customer: "Babu",
    items: [
      { product: "Notebook", quantity: 1, price: 5 },
      { product: "Pen", quantity: 2, price: 2 }
    ],
    status: "pending"
  },
  {
    _id: 3,
    customer: "Alice",
    items: [
      { product: "Pencil", quantity: 5, price: 1 }
    ],
    status: "delivered"
  }
]);


db.orders.aggregate([
  {
    $match: { status: "delivered" }
  },
  {
    $unwind: "$items"
  },
  {
    $project: {
      customer: 1,
      total: { $multiply: ["$items.quantity", "$items.price"] }
    }
  },
  {
    $group: {
      _id: "$customer",
      totalSpent: { $sum: "$total" }
    }
  },
  {
    $sort: { totalSpent: -1 }
  }
]);


